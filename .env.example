# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit actual credentials.

# OpenAI (used by ai_assistant.py, rag_engine.py)
OPENAI_API_KEY=

# Databricks / Unity Catalog (used by file_loader.py's load_table_from_databricks,
# validator.py --source databricks)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Azure OpenAI (used by rag_engine_azure.py -- embedding deployment name
# "dq-embed-small" is hardcoded in that file, not an env var)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Azure AI Search (used by rag_engine.py and rag_engine_azure.py's
# store_in_azure_search, index name "dq-reports-index")
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
